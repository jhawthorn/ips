#!/usr/bin/env ruby
# frozen_string_literal: true

versions = []
inline_code = []
ruby_flags = []
args = ARGV.dup
while args.first
  case args.first
  when "--ruby"
    args.shift
    versions << args.shift
  when "-e"
    args.shift
    inline_code << args.shift
  when "-r"
    args.shift
    ruby_flags.push("-r", args.shift)
  when "--disable-gems"
    args.shift
    ruby_flags << "--disable-gems"
  when "-v", "--verbose"
    args.shift
    verbose = true
  when /\A-/
    $stderr.puts "Unknown option: #{args.first}"
    exit 1
  else
    break
  end
end
script = args.shift

if script.nil? && inline_code.empty?
  $stderr.puts "Usage: ips [--ruby VERSION ...] [-e CODE ...] [<script>]"
  exit 1
end

if inline_code.any?
  script_source = +"require 'ips'\nIPS.run do |x|\n"
  inline_code.each do |code|
    script_source << "  x.report(#{code.inspect}, #{code.inspect})\n"
  end
  script_source << "end\n"
  ruby_args = ["-e", script_source]
else
  ruby_args = [script]
end

# Shell-escape for display purposes only, not for security.
def shell_quote(arg)
  return arg if arg =~ /\A[A-Za-z0-9_\-.,:+\/@]+\z/
  "'" + arg.gsub("'", "'\\\\''") + "'"
end

RUBY_DIRS = [File.expand_path("~/.rubies"), "/opt/rubies"]
LIB_DIR = File.expand_path("../lib", __dir__)

def find_ruby(version)
  RUBY_DIRS.each do |dir|
    next unless Dir.exist?(dir)
    Dir.children(dir).sort.each do |name|
      bare = name.delete_prefix("ruby-")
      if bare.start_with?(version)
        ruby = File.join(dir, name, "bin", "ruby")
        return ruby if File.executable?(ruby)
      end
    end
  end
  nil
end

versions << nil if versions.empty?

versions.each do |version|
  if version
    ruby = find_ruby(version)
    if ruby.nil?
      $stderr.puts "No ruby found matching #{version.inspect}"
      exit 1
    end
    env = { "GEM_HOME" => nil, "GEM_PATH" => nil }
  else
    ruby = "ruby"
    env = {}
  end

  cmd = [ruby, *ruby_flags, "-v", "-I", LIB_DIR, *ruby_args]
  $stderr.puts cmd.map { |a| shell_quote(a) }.join(" ") if verbose
  system(env, *cmd, exception: true)
  puts
end
